# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Ваш Telegram ID
ADMIN_ID=194637210

# Пусто = бот для всех. Чтобы пользовались только вы — впишите свой ID: ALLOWED_IDS=194637210
ALLOWED_IDS=

# --- Распознавание речи для видео без субтитров (необязательно) ---
# Без ключа бот работает только с субтитрами.
# Вариант 1: ProxyAPI (оплата российской картой)
#   WHISPER_BASE_URL=https://api.proxyapi.ru/openai/v1
#   WHISPER_MODEL=whisper-1
# Вариант 2: Groq (дешевле/бесплатный лимит, но нужен аккаунт не из РФ)
#   WHISPER_BASE_URL=https://api.groq.com/openai/v1
#   WHISPER_MODEL=whisper-large-v3
WHISPER_API_KEY=
WHISPER_BASE_URL=
WHISPER_MODEL=whisper-1
MAX_WHISPER_MINUTES=90

# Прокси для YouTube, если он заблокирует сервер: http://user:pass@host:port
YT_PROXY=

MAX_PARALLEL=2
